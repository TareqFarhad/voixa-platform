PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://voixa:voixa_dev_password@localhost:5432/voixa?schema=public

# Redis / Queue
REDIS_URL=redis://localhost:6379
PROCESSING_QUEUE=voixa.processing

# Auth
JWT_SECRET=replace-with-a-long-random-secret-value
JWT_EXPIRES_IN=7d

# Storage (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.storage
PUBLIC_STORAGE_URL=http://localhost:4000/api/storage

# S3 / R2 (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=voixa
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web origin (CORS)
WEB_ORIGIN=http://localhost:3000
